{
  "name": "u-board-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || >=24.15.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "postinstall": "npm run build:lib --workspace=packages/designer --workspace=packages/mcp",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint packages scripts test-support",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "build": "npm run build:lib && npm run build --workspaces --if-present",
    "build:lib": "npm run build:lib --workspaces --if-present",
    "test:tooling": "node --test scripts/*.test.mjs",
    "smoke:library": "node scripts/smoke-library.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "node scripts/check.mjs",
    "check:dependency-drift": "node scripts/check-dependency-drift.mjs --strict",
    "check:public-text": "node scripts/check-public-text.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:package-types": "attw --pack packages/designer --profile esm-only --exclude-entrypoints ./styles.css",
    "check:image": "node scripts/check-image.mjs",
    "release:image": "node scripts/release-image.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "oxlint": "^1.86.0"
  }
}
