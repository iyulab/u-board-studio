---
// The frame every page of the site shares: the head (title, description, language alternates, link
// preview), the bar at the top and the footer. A page passes which page it is and its own words.
import '@fontsource/ibm-plex-sans-kr/400.css';
import '@fontsource/ibm-plex-sans-kr/600.css';
import '../styles/site.css';
import {
  COPY,
  PATHS,
  SITE_URL,
  SOURCE_URL,
  LIBRARY_URL,
  DOCS_URL,
  PRODUCT_DOCS_URL,
  SELF_HOSTING_URL,
  NPM_URL,
  CONTACT_URL,
  type Locale,
  type PageId,
} from '../copy';

interface Props {
  locale: Locale;
  /** Which page of the site this is — its bar link is marked current. */
  page: PageId;
  title: string;
  description: string;
  /** Where this page lives in each language, when it is not the section's own page (a board of the gallery). */
  paths?: { ko: string; en: string };
  /** The link preview's picture, when the page has its own (a board's thumbnail); else the site's. */
  image?: { path: string; width: number; height: number; alt: string };
  /** Structured data for search engines (schema.org), written into the head as JSON-LD. */
  jsonLd?: object[];
}

const { locale, page, title, description, jsonLd = [] } = Astro.props;
const paths = Astro.props.paths ?? PATHS[page];
const c = COPY[locale];
const other: Locale = locale === 'ko' ? 'en' : 'ko';
const url = (path: string) => new URL(path, SITE_URL).href;
const canonical = url(paths[locale]);
const image = Astro.props.image ?? { path: `/og-${locale}.png`, width: 1200, height: 630, alt: c.title };
---

<!doctype html>
<!-- The site has one, light, palette. Declaring it keeps the live board's widgets and frames light
     on a dark system too (they follow a declared theme, else the system preference). -->
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ko" href={url(paths.ko)} />
    <link rel="alternate" hreflang="en" href={url(paths.en)} />
    <link rel="alternate" hreflang="x-default" href={url(paths.ko)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="U-Board" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:image" content={url(image.path)} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map(data => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <header class="bar">
      <a class="mark" href={PATHS.home[locale]}>U-Board</a>
      <nav aria-label={locale === 'ko' ? '바로가기' : 'Shortcuts'}>
        <a href={PATHS.gallery[locale]} aria-current={page === 'gallery' ? 'page' : undefined}>{c.gallery.nav}</a>
        <a href={PATHS.playground[locale]} aria-current={page === 'playground' ? 'page' : undefined}>{c.playground.nav}</a>
        <a href={PRODUCT_DOCS_URL}>{c.footer.docs}</a>
        <a href={paths[other]} hreflang={other} lang={other}>{c.otherLanguage}</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="foot-inner">
        <nav aria-label={locale === 'ko' ? '사이트 바깥 링크' : 'Elsewhere'}>
          <p class="foot-group">
            <strong>{c.footer.product}</strong>
            <a href={SOURCE_URL}>{c.footer.source}</a>
            <a href={PRODUCT_DOCS_URL}>{c.footer.docs}</a>
            <a href={SELF_HOSTING_URL}>{c.footer.selfHosting}</a>
          </p>
          <p class="foot-group">
            <strong>{c.footer.library}</strong>
            <a href={LIBRARY_URL}>{c.footer.source}</a>
            <a href={DOCS_URL}>{c.footer.docs}</a>
            <a href={NPM_URL}>{c.footer.npm}</a>
          </p>
          <p class="foot-group">
            <a href={CONTACT_URL}>{c.footer.contact}</a>
          </p>
        </nav>
        <div class="foot-meta">
          <uplatform-affiliation product="u-board" lang={locale} theme="light"></uplatform-affiliation>
          <p>© 2026 iyulab</p>
        </div>
      </div>
    </footer>
    <script>
      import '@uplatform/brand';
    </script>
  </body>
</html>
