---
import Page from './Page.astro';
import HeroBoard from './HeroBoard.astro';
import PlantFigure from './PlantFigure.astro';
import { COPY, APP_URL, PATHS, SOURCE_URL, SELF_HOSTING_URL, type Locale } from '../copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = COPY[locale];
---

<Page locale={locale} page="home" title={c.title} description={c.description}>
  <section class="hero">
    <div class="hero-text">
      <h1>{c.headline}</h1>
      <p class="lede" data-claim={c.lede.claim}>{c.lede.text}</p>
      <p class="actions">
        <a class="primary" href={SELF_HOSTING_URL}>{c.install}</a>
        <a class="secondary" href={PATHS.try[locale]} data-claim="try">{c.tryIt}</a>
      </p>
      <p class="sign-in"><a href={PATHS.gallery[locale]} data-claim="gallery">{c.gallery.heading}</a> · <a href={PATHS.playground[locale]}>{c.playground.heading}</a> · <a href={SOURCE_URL}>{c.readSource}</a> · <a href={APP_URL}>{c.signIn}</a></p>
    </div>
    <HeroBoard locale={locale} />
  </section>

  {
    c.sections
      .filter(s => s.claim === 'language')
      .map(s => (
        <section class="statement" data-claim={s.claim}>
          <h2>{s.heading}</h2>
          <p>{s.body}</p>
          <p class="statement-links">
            <a href={PATHS.playground[locale]}>{c.playground.heading} →</a>
            <a href={PATHS.gallery[locale]}>{c.gallery.heading} →</a>
          </p>
        </section>
      ))
  }

  <section class="assistant" aria-labelledby="assistant-heading" data-claim={c.assistant.claim}>
    <div class="assistant-text">
      <h2 id="assistant-heading">{c.assistant.heading}</h2>
      <p>{c.assistant.body}</p>
    </div>
    <figure class="assistant-film">
      <video data-assistant-film autoplay muted loop playsinline preload="metadata" poster="/media/chat-builder-poster.jpg" width="1600" height="900" aria-label={c.assistant.video}>
        <source src="/media/chat-builder.webm" type="video/webm" />
        <source src="/media/chat-builder.mp4" type="video/mp4" />
      </video>
      <figcaption>{c.assistant.caption}</figcaption>
    </figure>
  </section>

  {
    c.sections
      .filter(s => s.claim === 'quality')
      .map(s => (
        <section class="quality" data-claim={s.claim}>
          <div class="quality-text">
            <h2>{s.heading}</h2>
            <p>{s.body}</p>
          </div>
          <PlantFigure figure={c.figure} />
        </section>
      ))
  }

  <section class="facts">
    {
      c.sections
        .filter(s => s.claim !== 'quality' && s.claim !== 'language')
        .map(s => (
          <article data-claim={s.claim}>
            <h2>{s.heading}</h2>
            <p>{s.body}</p>
          </article>
        ))
    }
  </section>

  <section class="delivery" aria-labelledby="delivery-heading">
    <h2 id="delivery-heading">{c.delivery.heading}</h2>
    <dl>
      {
        c.delivery.items.map(item => (
          <div data-claim={item.claim}>
            <dt>{item.heading}</dt>
            <dd>{item.body}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="not" aria-labelledby="not-heading">
    <h2 id="not-heading">{c.notHeading}</h2>
    <ul>
      {
        c.not.map(item => (
          <li data-claim={item.claim}>
            <strong>{item.heading}</strong> {item.body}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="license" data-claim={c.license.claim}>
    <h2>{c.license.heading}</h2>
    <p>{c.license.body}</p>
  </section>
</Page>

<script>
  // Asked for less motion: the film stays on its poster, with controls to play it.
  const film = document.querySelector<HTMLVideoElement>('[data-assistant-film]');
  if (film && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    film.removeAttribute('autoplay');
    film.pause();
    film.controls = true;
  }
</script>
