---
// One board of the gallery on a page of its own: what it is (title, field, tags, summary), the board itself — drawn by
// the library viewer from the recorded answers once the page runs script — and what it is made of: its definition and
// its data, as the JSON U-Board reads, to read here or download. Then the boards near it.
import Page from './Page.astro';
import Card from './Card.astro';
import { COPY, PATHS, SITE_URL, type Locale } from '../copy';
import { tagsOf, type SamplePack } from '@iyulab/u-board-samples';
import { boardExtent, boardFiles, boardPaths, dataOf, definitionShown, recordedNote, relatedTo, shortDescription, thumbnailOf } from '../gallery';

interface Props {
  locale: Locale;
  pack: SamplePack;
}

const { locale, pack } = Astro.props;
const c = COPY[locale];
const g = c.gallery;
const b = g.board;
const title = pack.title[locale];
const description = shortDescription(pack.summary[locale], locale);
const paths = boardPaths(pack.id);
const files = boardFiles(pack.id);
const tags = tagsOf(pack);
const thumb = thumbnailOf(pack.id);
const extent = boardExtent(pack);
const aspect = extent ? `aspect-ratio: ${extent.width} / ${extent.height}; --ratio: ${(extent.width / extent.height).toFixed(3)}` : undefined;
const portrait = !!extent && extent.height > extent.width;
const recorded = recordedNote(pack, locale);
const definition = definitionShown(pack, b.imageElided);
const data = JSON.stringify(dataOf(pack), null, 2);
const related = relatedTo(pack);
const url = (path: string) => new URL(path, SITE_URL).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: title,
    headline: title,
    description: pack.summary[locale],
    inLanguage: locale,
    url: url(paths[locale]),
    ...(thumb && { image: url(thumb.path), thumbnailUrl: url(thumb.path) }),
    keywords: tags.map(t => t.label[locale]).join(', '),
    genre: pack.field[locale],
    isPartOf: { '@type': 'CollectionPage', name: g.heading, url: url(PATHS.gallery[locale]) },
    creator: { '@type': 'Organization', name: 'iyulab' },
    dateModified: pack.snapshot.capturedAt,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'U-Board', item: url(PATHS.home[locale]) },
      { '@type': 'ListItem', position: 2, name: b.back, item: url(PATHS.gallery[locale]) },
      { '@type': 'ListItem', position: 3, name: title, item: url(paths[locale]) },
    ],
  },
];
---

<Page
  locale={locale}
  page="gallery"
  title={g.boardTitle.replace('{title}', title)}
  description={description}
  paths={paths}
  image={thumb && { ...thumb, alt: title }}
  jsonLd={jsonLd}
>
  <article class="board-page">
    <nav class="crumbs" aria-label={b.back}>
      <a href={PATHS.gallery[locale]}>{b.back}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{title}</span>
    </nav>
    <header class="board-head">
      <h1>{title}</h1>
      <p class="board-field">{pack.field[locale]} · {pack.kind[locale]}</p>
      <ul class="board-tags" aria-label={b.tags}>
        {tags.map(t => <li><a class={`tag tag--${t.group}`} href={`${PATHS.gallery[locale]}?tag=${t.id}`}>{t.label[locale]}</a></li>)}
      </ul>
      <p class="board-summary">{pack.summary[locale]}</p>
    </header>
    <div class:list={['sample-board', { 'sample-board--grid': !aspect, 'sample-board--portrait': portrait }]} style={aspect} data-sample-board={pack.id} data-label={title}>
      {thumb ? <img src={thumb.path} width={thumb.width} height={thumb.height} alt={title} /> : <noscript>{pack.summary[locale]}</noscript>}
    </div>
    <p class="board-recorded">{recorded}</p>
    <p class="board-actions"><a class="board-open" href={`${PATHS.playground[locale]}?board=${pack.id}`}>{b.openPlayground} →</a></p>

    <section class="board-json">
      <details>
        <summary>{b.definition}</summary>
        <p>{b.definitionNote}</p>
        <a class="json-download" href={files.definition} download={`${pack.id}.board.json`}>{b.download} — board.json</a>
        <pre><code>{definition}</code></pre>
      </details>
      <details>
        <summary>{b.data}</summary>
        <p>{b.dataNote}</p>
        <a class="json-download" href={files.data} download={`${pack.id}.data.json`}>{b.download} — data.json</a>
        <pre><code>{data}</code></pre>
      </details>
    </section>

    {
      related.length > 0 && (
        <section class="board-related">
          <h2>{b.related}</h2>
          <ul class="cards">
            {related.map(card => <Card card={card} locale={locale} />)}
          </ul>
        </section>
      )
    }
  </article>
</Page>

<script>
  import '../live/gallery';
</script>

<style>
  .board-page {
    padding-block: 1.5rem 3rem;
    /* The board's box takes its height from the page's width (cqi). */
    container-type: inline-size;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .board-head {
    max-width: 52rem;
  }
  .board-head h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
  }
  .board-field {
    margin: 0 0 0.6rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .board-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 0.9rem;
    padding: 0;
    list-style: none;
  }
  .tag {
    display: inline-block;
    font-size: 0.8125rem;
    line-height: 1.4;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: #e3e9e8;
    color: var(--drawing-strong);
    text-decoration: none;
  }
  .tag:hover {
    text-decoration: underline;
  }
  .tag--domain {
    background: #dbe8f3;
    color: #1d4e75;
  }
  .board-summary {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }
  .sample-board {
    width: 100%;
    margin-top: 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
    background: #ffffff;
  }
  .sample-board img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The viewer's toolbar and its credit line sit inside the box with the board, so give them room: as tall as the
     board is at the page's width (its drawing's proportions, or its parts'), plus those two, and never past the screen. */
  .sample-board.live {
    aspect-ratio: auto !important;
    height: min(80vh, 760px, calc(100cqi / var(--ratio, 1.6) + 76px));
  }
  /* A portrait board (a kiosk, a printed page) is as wide as the height it gets allows. */
  .sample-board--portrait {
    max-width: calc((min(80vh, 760px) - 76px) * var(--ratio) + 2px);
    margin-inline: auto;
  }
  .sample-board--grid:not(.live) {
    min-height: 32rem;
  }
  .sample-board--grid.live {
    height: auto;
  }
  .board-recorded {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .board-actions {
    margin: 1rem 0 0;
  }
  .board-open {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    background: var(--ink);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .board-open:hover {
    text-decoration: underline;
  }
  .board-json {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .board-json details {
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--sheet);
    padding: 0.75rem 1rem;
  }
  .board-json summary {
    font-weight: 600;
    cursor: pointer;
  }
  .board-json p {
    margin: 0.6rem 0;
    font-size: 0.875rem;
    color: var(--muted);
    max-width: 52rem;
  }
  .json-download {
    font-size: 0.875rem;
  }
  .board-json pre {
    max-height: 32rem;
    overflow: auto;
    margin: 0.75rem 0 0;
    padding: 0.75rem;
    border-radius: 6px;
    background: #17252b;
    color: #e6eeee;
    font-size: 0.8rem;
    line-height: 1.5;
    white-space: pre;
    word-break: normal;
    overflow-wrap: normal;
  }
  .board-related {
    margin-top: 2.5rem;
  }
  .board-related h2 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }
</style>
