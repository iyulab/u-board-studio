---
// The gallery's list: a card per board — its picture, title, field and tags — each opening the board's own page, and a
// filter by tag over them. Every card is in the page as written, so the list reads (and is indexed) without script;
// the filter is the script's.
import Page from './Page.astro';
import { COPY, SITE_URL, type Locale } from '../copy';
import { ALL_TAGS } from '@iyulab/u-board-samples';
import Card from './Card.astro';
import { CARDS, boardPaths } from '../gallery';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = COPY[locale];
const g = c.gallery;
const groups = (['domain', 'style', 'trait'] as const).map(group => ({
  group,
  name: g.filter.groups[group],
  tags: ALL_TAGS.filter(t => t.group === group).map(t => ({ ...t, count: CARDS.filter(card => card.tags.some(x => x.id === t.id)).length })),
}));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: g.heading,
    description: g.description,
    inLanguage: locale,
    hasPart: CARDS.map(({ pack }) => ({ '@type': 'CreativeWork', name: pack.title[locale], url: new URL(boardPaths(pack.id)[locale], SITE_URL).href })),
  },
];
---

<Page locale={locale} page="gallery" title={g.title} description={g.description} jsonLd={jsonLd}>
  <section class="gallery" data-claim="gallery">
    <div class="gallery-head">
      <h1>{g.heading}</h1>
      <p>{g.intro}</p>
    </div>
    <div class="filter" data-gallery-filter data-count-text={g.filter.count}>
      <h2 class="filter-label">{g.filter.label}</h2>
      {
        groups.map(({ group, name, tags }) => (
          <div class="filter-group" role="group" aria-label={name}>
            <span class="filter-group-name">{name}</span>
            {tags.map(t => (
              <button type="button" class={`chip chip--${group}`} data-tag={t.id} aria-pressed="false">
                {t.label[locale]} <span class="chip-count">{t.count}</span>
              </button>
            ))}
          </div>
        ))
      }
      <p class="filter-status">
        <span data-gallery-count aria-live="polite">{g.filter.count.replace('{n}', String(CARDS.length))}</span>
        <button type="button" class="filter-clear" data-gallery-clear hidden>{g.filter.clear}</button>
      </p>
    </div>
    <ul class="cards" aria-label={g.index}>
      {
        CARDS.map(card => <Card card={card} locale={locale} />)
      }
    </ul>
    <p class="filter-none" data-gallery-none hidden>{g.filter.none}</p>
  </section>
</Page>

<script>
  import '../live/gallery-filter';
</script>

<style>
  .gallery {
    padding-block: 2.5rem 3rem;
  }
  .gallery-head {
    max-width: 46rem;
    margin-bottom: 1.5rem;
  }
  .gallery-head h1 {
    margin: 0 0 0.75rem;
  }
  .gallery-head p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }
  .filter {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--sheet);
  }
  .filter-label {
    font-size: 1rem;
  }
  .filter-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .filter-group-name {
    min-width: 3.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .chip {
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1.3;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
  }
  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .chip:focus-visible,
  .filter-clear:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .chip-count {
    color: var(--muted);
  }
  .chip[aria-pressed='true'] .chip-count {
    color: #cfd8da;
  }
  .filter-status {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
  }
  .filter-clear {
    font: inherit;
    padding: 0;
    border: 0;
    background: none;
    color: var(--focus);
    text-decoration: underline;
    cursor: pointer;
  }
  .filter-none {
    color: var(--muted);
  }
</style>
