---
import Page from './Page.astro';
import { SAMPLE_PACKS } from '@iyulab/u-board-samples';
import { COPY, type Locale } from '../copy';
import { HERO_BOARD } from '../gallery';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = COPY[locale];
const t = c.try;
const pack = SAMPLE_PACKS.find(p => p.id === HERO_BOARD);
if (!pack) throw new Error(`The board "${HERO_BOARD}" is not in the gallery`);
const playground = JSON.stringify({
  board: HERO_BOARD,
  source: t.source,
  saved: t.saved,
  unsaved: t.unsaved,
});
---

<Page locale={locale} page="try" title={t.title} description={t.description}>
  <section class="try" data-claim="try">
    <div class="try-head">
      <h1>{t.heading}</h1>
      <p>{t.intro.replace('{board}', pack.title[locale])}</p>
      <p class="try-narrow">{t.narrow}</p>
    </div>
    <div class="try-tools">
      <span class="try-status" data-playground-status role="status"></span>
      <button type="button" data-playground-reset>{t.reset}</button>
    </div>
    <div class="try-editor" data-playground={playground}>
      <noscript>{t.description}</noscript>
    </div>
  </section>
</Page>

<script>
  import '../live/playground';
</script>

<style>
  .try {
    padding-block: 2.5rem 3rem;
  }
  .try-head {
    max-width: 46rem;
  }
  .try-head h1 {
    margin: 0 0 0.75rem;
  }
  .try-head p {
    margin: 0 0 0.5rem;
    color: var(--muted);
    line-height: 1.65;
    word-break: keep-all;
  }
  /* Said only where it is true: a screen too narrow for the editor's two panes and its panel. */
  .try-narrow {
    display: none;
  }
  @media (max-width: 760px) {
    .try-narrow {
      display: block;
    }
  }
  .try-tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    margin: 1.25rem 0 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .try-tools button {
    font: inherit;
    padding: 0.35rem 0.8rem;
    border-radius: 4px;
    border: 0;
    box-shadow: inset 0 0 0 1.5px var(--ink);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  /* The editor frames its own panes; this box only gives it a height to fill. */
  .try-editor {
    height: max(560px, calc(100vh - 220px));
  }
</style>
