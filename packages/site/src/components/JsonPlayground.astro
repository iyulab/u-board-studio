---
// The JSON playground: pick a board of the gallery, edit its definition and data as text, and see it drawn beside them.
import Page from './Page.astro';
import { COPY, PATHS, type Locale } from '../copy';
import { SAMPLE_PACKS } from '@iyulab/u-board-samples';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = COPY[locale];
const t = c.playground;
const text = JSON.stringify({ definition: t.definition, data: t.data, loading: t.loading, loadFailed: t.loadFailed, opensBoard: t.opensBoard, ok: t.ok, problems: t.problems });
// The first board offered: a small one on live open data, quick to read.
const first = 'seoul-air';
---

<Page locale={locale} page="playground" title={t.title} description={t.description}>
  <section class="pg" data-json-playground={text} data-claim="playground">
    <div class="pg-head">
      <h1>{t.heading}</h1>
      <p>{t.intro}</p>
      <p><a href={PATHS.try[locale]}>{t.toTry}</a></p>
    </div>
    <div class="pg-tools">
      <label>
        {t.board}
        <select data-board-picker>
          {SAMPLE_PACKS.map(pack => <option value={pack.id} selected={pack.id === first}>{pack.title[locale]}</option>)}
        </select>
      </label>
      <span class="pg-status" data-status role="status"></span>
    </div>
    <ul class="pg-problems" data-problems aria-label={t.problems.replace('{n}', '')}></ul>
    <div class="pg-body">
      <div class="pg-text">
        <label class="pg-field">
          <span>{t.definition} <small>board</small></span>
          <textarea data-field="definition" spellcheck="false" autocomplete="off" autocapitalize="off"></textarea>
        </label>
        <label class="pg-field">
          <span>{t.data}</span>
          <textarea data-field="data" spellcheck="false" autocomplete="off" autocapitalize="off"></textarea>
        </label>
      </div>
      <div class="pg-view" data-view aria-label={t.view}>
        <noscript>{t.description}</noscript>
      </div>
    </div>
  </section>
</Page>

<script>
  import '../live/json-playground';
</script>

<style>
  .pg {
    padding-block: 2rem 3rem;
  }
  .pg-head {
    max-width: 52rem;
  }
  .pg-head h1 {
    margin: 0 0 0.75rem;
  }
  .pg-head p {
    margin: 0 0 0.5rem;
    color: var(--muted);
    line-height: 1.65;
  }
  .pg-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin: 1.25rem 0 0.5rem;
    font-size: 0.9375rem;
  }
  .pg-tools label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pg-tools select {
    font: inherit;
    max-width: min(28rem, 70vw);
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: #fff;
  }
  .pg-status {
    color: var(--muted);
  }
  .pg-problems {
    margin: 0 0 0.75rem;
    padding-left: 1.2rem;
    color: #a3261b;
    font-size: 0.875rem;
  }
  .pg-problems:empty {
    display: none;
  }
  .pg-body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 1rem;
    align-items: stretch;
  }
  .pg-text {
    display: grid;
    grid-template-rows: 3fr 2fr;
    gap: 0.75rem;
    min-height: 0;
  }
  .pg-field {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.3rem;
    min-height: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .pg-field small {
    font-weight: 400;
    color: var(--muted);
  }
  .pg-field textarea {
    width: 100%;
    min-height: 12rem;
    resize: vertical;
    padding: 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: #17252b;
    color: #e6eeee;
    font: 0.8rem/1.5 ui-monospace, 'SFMono-Regular', Consolas, monospace;
    white-space: pre;
    overflow-wrap: normal;
    tab-size: 2;
  }
  .pg-field textarea:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 1px;
  }
  .pg-view {
    height: min(80vh, 760px);
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }
  @media (max-width: 860px) {
    .pg-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .pg-view {
      order: -1;
      height: 60vh;
    }
  }
</style>
