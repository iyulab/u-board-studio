# UBOARD_DATABASE_URL: ":memory:" (tests only) | a local path (PGlite persisted to disk — the
# zero-setup local-dev default) | a "postgres://..." URL (production, real Postgres via pg.Pool).
# For a TLS connection, say sslmode=verify-full explicitly (certificate and hostname checked).
# pg 8 reads "require" as verify-full today, but pg 9 switches to libpq semantics, where
# "require" encrypts without checking the certificate.
UBOARD_DATABASE_URL=./u-board-data
UBOARD_SESSION_SECRET=change-me-to-a-random-32-char-string
# Seals connector credentials in the database (at least 32 characters, e.g. `openssl rand -base64 32`).
# Separate from the session secret; losing it leaves stored credentials unreadable.
UBOARD_SECRETS_KEY=change-me-to-another-random-string-of-32-chars
# To replace it: start once with the old key here and the new one above (docs/self-hosting.md).
# UBOARD_SECRETS_KEY_PREVIOUS=
# "true" to key the /auth/login and /auth/signup rate limiter off the CF-Connecting-IP header
# instead of req.ip. Enable ONLY once the server's ingress accepts traffic from Cloudflare alone —
# otherwise the header is client-spoofable.
UBOARD_TRUST_CF_PROXY=
# Seconds a connector's last-known value may still be shown as stale when a read fails; past it the
# binding shows as disconnected. Unset: no limit — the value is shown however old, with its age.
UBOARD_STALE_MAX_AGE_SECONDS=
# Who may embed the share viewer in a frame (a CSP frame-ancestors source list). Default: https:
# — set e.g. "http://hmi.example.com https:" when an intranet page served over plain HTTP embeds it.
UBOARD_SHARE_FRAME_ANCESTORS=
PORT=4000
# Who may create workspaces: "operator" (default — the installation's operator, which the first
# account to sign up becomes) or "anyone" (every signed-in account).
UBOARD_WORKSPACE_CREATION=
# Days the record of membership, role and invitation changes is kept (default 180). Older records are purged.
UBOARD_AUDIT_RETENTION_DAYS=
# Which addresses connectors (data sources, OAuth token endpoints) may reach: "private" (default —
# public addresses and private networks: 10/8, 172.16/12, 192.168/16, 100.64/10, 198.18/15, IPv6 unique
# local), "public" (public addresses only — for an installation run for others), or "any". Except under
# "any", this host's loopback and link-local addresses (such as a cloud metadata service) are refused.
UBOARD_CONNECTOR_ADDRESSES=
# The origin people open the console at, e.g. https://board.example.com — links in email (invitations)
# point here. Unset: invitations are not emailed; the console shows the link for the owner to pass on.
UBOARD_PUBLIC_URL=
# Email delivery for password-reset codes and invitations through Sendway (an email/SMS/push notification service):
# the tenant key, and the origin of the Sendway deployment to send through. Unset in dev/test — falls back to a log-the-token default that keeps the
# reset flow fully usable without a real provider. SENDWAY_BASE_URL is required whenever
# SENDWAY_API_KEY is set; the server refuses to start with one and not the other.
SENDWAY_API_KEY=
SENDWAY_BASE_URL=
