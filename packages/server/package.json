    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pg": "^8.23.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/cookie-parser": "^1.4.8",
