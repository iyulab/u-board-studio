{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  // No "exclude": the test files must be part of the program `typecheck` compiles, or type
  // errors in them go unnoticed. Shipping them is a separate concern — tsconfig.build.json
  // excludes them from the emitted `dist/`.
  "include": ["src"]
}
