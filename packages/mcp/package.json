{
  "name": "@iyulab/u-board-mcp",
  "version": "0.25.0",
  "description": "MCP server that lets an AI assistant read and draw U-Board boards through a workspace API token",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tools": {
      "types": "./dist/tools-entry.d.ts",
      "import": "./dist/tools-entry.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "u-board-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:lib": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "start": "node dist/index.js",
    "prepack": "node scripts/prepack.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyulab/u-board-studio.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/iyulab/u-board-studio/issues"
  },
  "homepage": "https://github.com/iyulab/u-board-studio/tree/main/packages/mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dashboard",
    "ai",
    "u-board"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@iyulab/u-board": "^0.39.0",
    "@iyulab/u-board-designer": "^0.1.0",
    "@iyulab/u-widgets": "^0.45.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
